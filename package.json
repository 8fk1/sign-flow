{
  "name": "sign-flow",
  "productName": "sign-flow",
  "version": "1.0.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . --icon=./static/img/32x32.ico --overwrite",
    "b": "node_modules/.bin/electron-builder build",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder",
    "build:win": "electron-builder build --win --publish never",
    "release:win": "electron-builder build --win --publish always"
  },
  "build": {
    "appId": "net.katsubemakto.blog.app.my",
    "npmRebuild": false,
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "8fk1",
      "repo": "sign-flow",
      "private": true
    }
  },
  "keywords": [],
  "author": "DESKTOP-RQTS4S9 <fujiwarayuuki@summitsystem.co.jp>",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "playwright-core": "^1.60.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.4.120",
    "yarn": "^1.22.22"
  },
  "repository": "https://github.com/8fk1/sign-flow.git"
}
