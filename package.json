{
  "name": "sign-flow",
  "productName": "sign-flow",
  "version": "1.0.8",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . --icon=./static/img/32x32.ico --overwrite",
    "b": "node_modules/.bin/electron-builder build",
    "generate-licenses": "node scripts/generate-licenses.js",
    "app:dir": "node scripts/extract-release-notes.js && node scripts/generate-licenses.js && electron-builder --dir",
    "app:dist": "node scripts/extract-release-notes.js && node scripts/generate-licenses.js && electron-builder",
    "build:win": "node scripts/extract-release-notes.js && node scripts/generate-licenses.js && electron-builder build --win --publish never",
    "release:win": "node scripts/extract-release-notes.js && node scripts/generate-licenses.js && electron-builder build --win --publish always",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "net.katsubemakto.blog.app.my",
    "npmRebuild": false,
    "afterPack": "./scripts/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "package.json",
      "static/**/*",
      "private/HISTORY.md",
      "LICENSES.txt"
    ],
    "mac": {
      "target": "dmg",
      "icon": "static/img/icon/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": "nsis",
      "icon": "static/img/icon/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "build/license.txt"
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "publish": {
      "provider": "github",
      "owner": "8fk1",
      "repo": "sign-flow"
    }
  },
  "keywords": [],
  "author": "8fk1",
  "license": "ISC",
  "description": "Sign Flow application for stamping PDFs.",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "license-checker": "^25.0.1",
    "playwright-core": "^1.60.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.4.120",
    "yarn": "^1.22.22"
  },
  "repository": "https://github.com/8fk1/sign-flow.git"
}
